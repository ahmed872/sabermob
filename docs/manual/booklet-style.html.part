<style>
  :root {
    --brand: #4f46e5; --brand-soft: #eef2ff; --ink: #0f172a; --muted: #475569; --line: #e2e8f0;
    --ok: #15803d; --ok-soft: #ecfdf5; --warn: #b45309; --warn-soft: #fffbeb; --bad: #b91c1c; --bad-soft: #fef2f2;
  }
  @page { size: A4; margin: 16mm 15mm 18mm 15mm; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; background: #fff; color: var(--ink); font-family: Cairo, 'Segoe UI', Tahoma, sans-serif; font-size: 11.5pt; line-height: 1.85; }
  main { max-width: 820px; margin: 0 auto; padding: 0 16px; }
  @media print { main { max-width: none; padding: 0; } }

  h1, h2, h3 { line-height: 1.4; margin: 0; }
  h2 { font-size: 21pt; font-weight: 800; color: var(--ink); padding-bottom: 6px; margin-bottom: 14px; border-bottom: 3px solid var(--brand); display: flex; gap: 12px; align-items: baseline; }
  h2 .no { color: var(--brand); font-size: 26pt; }
  h3, h2 { break-after: avoid-page; }
  .keep { break-inside: avoid; }
  h3 { font-size: 13.5pt; font-weight: 700; margin: 18px 0 6px; color: var(--brand); }
  p { margin: 6px 0 8px; }
  ul, ol { margin: 6px 0 10px; padding-inline-start: 22px; }
  li { margin: 2px 0; }
  b, strong { font-weight: 700; }

  .chapter { break-before: page; }
  figure { margin: 12px 0 16px; break-inside: avoid; }
  figure img { width: 100%; display: block; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 2px 10px rgba(15, 23, 42, .08); }
  figure.half img { width: 78%; margin: 0 auto; }
  figcaption { font-size: 9.5pt; color: var(--muted); text-align: center; margin-top: 6px; }
  figcaption b { color: var(--ink); }

  .box { border-radius: 10px; padding: 10px 14px; margin: 12px 0; break-inside: avoid; border: 1px solid; }
  .box .t { font-weight: 800; display: block; margin-bottom: 2px; }
  .tip { background: var(--ok-soft); border-color: #a7f3d0; }
  .tip .t { color: var(--ok); }
  .note { background: var(--brand-soft); border-color: #c7d2fe; }
  .note .t { color: var(--brand); }
  .warn { background: var(--warn-soft); border-color: #fde68a; }
  .warn .t { color: var(--warn); }
  .danger { background: var(--bad-soft); border-color: #fecaca; }
  .danger .t { color: var(--bad); }

  kbd { font-family: inherit; font-size: 9.5pt; font-weight: 700; direction: ltr; unicode-bidi: isolate; display: inline-block; min-width: 26px; text-align: center; padding: 0 7px; border: 1px solid #cbd5e1; border-bottom-width: 3px; border-radius: 6px; background: #f8fafc; line-height: 1.7; }
  .path { font-weight: 700; color: var(--brand); white-space: nowrap; }
  .ltr { direction: ltr; unicode-bidi: isolate; }

  table { width: 100%; border-collapse: collapse; margin: 10px 0 14px; font-size: 10.5pt; break-inside: avoid; }
  th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: right; vertical-align: top; }
  th { background: #f1f5f9; font-weight: 700; }
  tr:nth-child(even) td { background: #fafafa; }

  .steps { counter-reset: s; list-style: none; padding: 0; }
  .steps > li { counter-increment: s; position: relative; padding-inline-start: 38px; margin: 8px 0; }
  .steps > li::before { content: counter(s); position: absolute; inset-inline-start: 0; top: 2px; width: 26px; height: 26px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; font-size: 10pt; display: grid; place-items: center; line-height: 1; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .grid2 figure { margin: 6px 0; }

  /* cover */
  .cover { height: 260mm; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 10px; }
  .logo { width: 110px; height: 110px; border-radius: 28px; background: linear-gradient(135deg, #3b82f6, #4f46e5); display: grid; place-items: center; box-shadow: 0 10px 30px rgba(79, 70, 229, .35); }
  .logo svg { width: 58px; height: 58px; }
  .cover h1 { font-size: 36pt; font-weight: 800; margin-top: 18px; }
  .cover .sub { font-size: 15pt; color: var(--muted); }
  .cover .tag { margin-top: 24px; font-size: 12pt; background: var(--brand-soft); color: var(--brand); border-radius: 999px; padding: 6px 22px; font-weight: 700; }
  .cover .meta { margin-top: 50px; color: var(--muted); font-size: 10.5pt; }

  /* contents */
  .toc ol { list-style: none; padding: 0; columns: 1; }
  .toc li { display: flex; gap: 12px; align-items: baseline; padding: 7px 0; border-bottom: 1px dashed var(--line); font-size: 12pt; }
  .toc li span.n { color: var(--brand); font-weight: 800; min-width: 28px; }
  .toc li span.d { color: var(--muted); font-size: 10pt; margin-inline-start: auto; }
  .toc a { color: inherit; text-decoration: none; font-weight: 700; }
</style>