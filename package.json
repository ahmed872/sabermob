{
  "name": "central-pro",
  "productName": "Central Pro",
  "version": "1.0.4",
  "description": "Offline-first POS, inventory, repairs and supplier management for telecom centers and mobile shops",
  "author": "Central Pro",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run prisma:generate && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.scripts.json",
    "prisma:generate": "prisma generate",
    "db:migration": "node scripts/new-migration.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "electron-vite build && playwright test",
    "dist:win": "npm run release:check && npm run build && electron-builder --win --x64 --config electron-builder.config.cjs",
    "dist:linux": "npm run build && electron-builder --linux dir --config electron-builder.config.cjs",
    "postinstall": "prisma generate",
    "license:init": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license/keygen.mts init",
    "license:issue": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license/keygen.mts issue",
    "license:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license/keygen.mts verify",
    "license:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/license/keygen.mts list",
    "release:check": "node scripts/release-check.mjs",
    "docs:booklet": "node scripts/manual/build-booklet.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:sim": "vitest run --config vitest.sim.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "papaparse": "5.7.0",
    "qrcode": "1.5.4",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/cairo": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "i18next": "26.4.2",
    "jsbarcode": "3.12.3",
    "jsqr": "1.4.0",
    "lucide-react": "1.50.0",
    "prisma": "7.10.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}
